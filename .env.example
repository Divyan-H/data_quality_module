# Copy to .env (never commit .env). docs/ENVIRONMENT_VARIABLES.md lists every variable.

# The name analysts type in the browser. `localhost` for a trial on one machine.
DQ_DOMAIN=localhost

# Access token for the web app and the API: 16+ characters. Generate:  openssl rand -base64 32
DQ_API_TOKEN=

# Secret key for Phase A's value hashes: 32+ random characters. Generate:  openssl rand -hex 32
STRUCTURE_HASH_KEY=

# Local models (must be pulled into the ollama container). The agent model should be a 7B+ instruct model.
DQ_LLM_MODEL=llama3.2:3b
DQ_AGENT_MODEL=qwen2.5:7b-instruct

# Optional
DQ_RETENTION_DAYS=
DQ_MAX_CONCURRENT_JOBS=2
DQ_VERSION=local

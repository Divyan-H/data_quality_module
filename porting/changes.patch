+"""Plain-English commands for the reshaping operations (and the two shape-safe ones Phase B also takes: split a
+column into columns, and if / else). Mixed into CommandParser; each handler returns a Plan, raises Ask, or returns
+None when the words are not its command.
+
+    unpivot Day 1 to Day 31 into rows as Day and Reactivated        turn the Day columns into rows
+    pivot Inactivity Bucket into columns using Reactivated [by Date, City] [(sum)]
+    split Full Name into First and Last [on space]                  (split column)
+    split City into rows sharing Usage [equally | keeping totals] [keeping Delhi NCR together]
+    allocate Spend, Reach by City from Audience using Pct matching Campaign [as whole numbers]
+    sum Impressions, Clicks by day, channel, network               count rows by A, B as orders
+    label channel not in Channels as Others [also network] [then sum clicks, installs by day]
+    net next-month negatives in Spend by Month per Site, Format
+    append DAP New to DAP Base where DATE >= 2025-09-09 renaming DATE as Date, CITY_NAME as City
+    look up CURRENT_AOV from AOV matching ORDER_DATE = ORDER_DATE, ORDER_CITY = CITY_NAME [in Orders]
+    convert Spend from USD to INR at 83.2 | at 86.5 for Q1 2025, 85 for Q2 2025 using Date
+    sort by Period, Geography [descending]                          make Date from Month and Day
+    add Month as the month of Order Date                            drop columns A, B · drop table AOV
+    set Tier to Gold if Spend > 100000, Silver if Spend > 50000, else Bronze
+"""
+from __future__ import annotations
+
+import re
+from datetime import date
+from typing import TYPE_CHECKING, Callable
+
+from ..operations import (Aggregate, AllocateByShare, AppendRows, BucketOthers, Classify, ConvertCurrency, DropColumns,
+                          DropTable, LookupJoin, MakeDate, MakePeriod, NetNextPeriod, Pivot, Plan, Rule, SortRows,
+                          SplitColumn, SplitRows, Unpivot)
+
+if TYPE_CHECKING:
+    from ..operations import Condition
+    from .context import PlanningContext
+
+SEPARATOR_WORDS = {"space": " ", "spaces": " ", "comma": ",", "commas": ",", "dash": "-", "hyphen": "-", "slash": "/",
+                   "semicolon": ";", "pipe": "|", "underscore": "_", "colon": ":", "dot": ".", "period": "."}
+
+
+class TransformCommands:
+    """Needs from the host (CommandParser): self.ctx, self.column(), self.columns(), self.conditions(), Ask, and the
+    helpers split_values / unquote / parse_number. They are declared here so the type checker can verify the calls."""
+
+    ctx: PlanningContext
+    Ask: type[Exception]
+    split_values: Callable[[str], list[str]]
+    unquote: Callable[[str], str]
+    parse_number: Callable[[str], float | None]
+
+    if TYPE_CHECKING:
+        def column(self, name: str) -> str: ...
+        def columns(self, spec: str) -> list[str]: ...
+        def conditions(self, spec: str) -> list[Condition]: ...
+
+    # ── helpers ──────────────────────────────────────────────────────────────
+    def _table_tail(self, text: str) -> tuple[str | None, str]:
+        """'… in Coupons' -> ('Coupons', '…') when the words name a table; else (None, text)."""
+        m = re.search(r"\s+(?:in|for|of|on|within)\s+(?:the\s+)?(?:table\s+|sheet\s+)?(?P<t>[^,]+?)(?:\s+(?:table|sheet))?$", text, re.I)
+        if m:
+            t = self.ctx.find_table(m.group("t"))
+            if t is not None and self.ctx.find_column(m.group("t")) is None:
+                return t, text[:m.start()].strip()
+        return None, text
+
+    def _table(self, name: str) -> str:
+        t = self.ctx.find_table(name)
+        if t is None:
+            raise self.Ask(f"I could not find a table called '{self.unquote(name)}'. The tables are: {', '.join(self.ctx.table_names)}.")
+        return t
+
+    def _cols_in(self, spec: str, table: str | None) -> list[str]:
+        """Columns by name, a range 'Day 1 to Day 31', or a list. Ranges follow the table's column order."""
+        cols = self.ctx.columns_of(table)
+        m = re.fullmatch(r"(?P<a>.+?)\s*(?:to|through|-|–|\.\.\.?|…)\s*(?P<b>.+)", spec.strip(), re.I)
+        if m:
+            a, b = self.ctx.find_column(m.group("a")), self.ctx.find_column(m.group("b"))
+            if a in cols and b in cols:
+                i, j = cols.index(a), cols.index(b)
+                return cols[min(i, j):max(i, j) + 1]
+        return self.columns(spec)
+
+    def _pairs(self, spec: str) -> dict[str, str]:
+        """'A = B, C = D' or 'A as B' -> {A: B}; a bare name means the same name on both sides."""
+        out = {}
+        for part in re.split(r"\s*,\s*(?:and\s+)?|\s+and\s+", spec.strip()):
+            if not part:
+                continue
+            m = re.match(r"(?P<a>.+?)\s*(?:=|->|\bas\b|\bto\b|\bwith\b)\s*(?P<b>.+)$", part, re.I)
+            a, b = (m.group("a"), m.group("b")) if m else (part, part)
+            out[self.unquote(a.strip())] = self.unquote(b.strip())
+        return out
+
+    # ── unpivot / pivot ──────────────────────────────────────────────────────
+    def _unpivot(self, t: str) -> Plan | None:
+        m = re.match(r"(?:unpivot|melt|turn|convert|reshape|transpose)\s+(?:the\s+)?(?P<cols>.+?)\s+(?:columns?\s+)?(?:in)?to\s+(?:long\s+)?rows?"
+                     r"(?:\s+(?:as|called|named|with|giving)\s+(?P<names>.+?))?$", t, re.I) \
+            or re.match(r"(?:unpivot|melt)\s+(?:the\s+)?(?P<cols>.+?)(?:\s+(?:as|into|giving)\s+(?P<names>.+?))?$", t, re.I)
+        if not m:
+            return None
+        table, cols_spec = self._table_tail(m.group("cols"))
+        names = [self.unquote(x) for x in re.split(r"\s+and\s+|\s*,\s*|\s*/\s*", m.group("names") or "") if x.strip()]
+        spec = re.sub(r"\s+columns?$", "", cols_spec.strip(), flags=re.I)
+        prefix = re.fullmatch(r"(?:all\s+)?(?:the\s+)?(?:columns?\s+(?:starting|beginning)\s+with\s+)?['\"]?(?P<p>[A-Za-z][\w ]*?)['\"]?(?:\s*\*|\s+N|\s+columns?)?", spec, re.I)
+        op_kw = {"table": table, "names_to": names[0] if names else None, "values_to": names[1] if len(names) > 1 else "Value"}
+        cols = None
+        try:
+            cols = self._cols_in(spec, table)
+        except self.Ask:
+            if not prefix:
+                raise
+        if cols and len(cols) > 1:
+            return Plan(ops=[Unpivot(columns=cols, **{k: v for k, v in op_kw.items() if v is not None},
+                                     **({} if op_kw["names_to"] else {"names_to": _stem(cols)}))])
+        p = (prefix.group("p").strip() if prefix else spec)
+        pattern = rf"^{re.escape(p)}\s*\d+$"
+        matched = [c for c in self.ctx.columns_of(table) if re.match(pattern, c, re.I)]
+        if not matched:
+            raise self.Ask(f"No columns look like '{p} 1', '{p} 2' …. Name the columns, e.g. 'unpivot Day 1 to Day 31'.")
+        if table is None:
+            having = [t.ref for t in self.ctx.tables if any(re.match(pattern, c, re.I) for c in t.cols)]
+            op_kw["table"] = having[0] if len(having) == 1 else None
+        return Plan(ops=[Unpivot(pattern=pattern, **{k: v for k, v in op_kw.items() if v is not None},
+                                 **({} if op_kw["names_to"] else {"names_to": p}))])
+
+    def _pivot(self, t: str) -> Plan | None:
+        m = re.match(r"(?:pivot|spread|turn)\s+(?:the\s+)?(?:values\s+of\s+)?(?P<col>.+?)\s+(?:in)?to\s+columns?"
+                     r"(?:\s+(?:using|with|holding|of|from|filled\s+with)\s+(?P<vals>.+?))?"
+                     r"(?:\s+(?:by|per|for\s+each|keeping)\s+(?P<idx>.+?))?(?:\s*\(?(?P<agg>sum|mean|average|first|count)\)?)?$", t, re.I)
+        if not m:
+            return None
+        table, col_spec = self._table_tail(m.group("col"))
+        col = self.column(col_spec)
+        if not m.group("vals"):
+            raise self.Ask(f"Which column's numbers should fill the new {col} columns? e.g. 'pivot {col} into columns using Value'.")
+        vals_spec = m.group("vals")
+        if not table:
+            table, vals_spec = self._table_tail(vals_spec)
+        vals = self.column(vals_spec)
+        idx = self.columns(m.group("idx")) if m.group("idx") else [c for c in self.ctx.columns_of(table) if c not in (col, vals)]
+        agg = {"average": "mean"}.get((m.group("agg") or "sum").lower(), (m.group("agg") or "sum").lower())
+        return Plan(ops=[Pivot(table=table, index=idx, columns_from=col, values_from=vals, agg=agg)])
+
+    # ── split ────────────────────────────────────────────────────────────────
+    def _split_rows(self, t: str) -> Plan | None:
+        m = re.match(r"(?:split|explode|break)\s+(?:the\s+)?(?:rows\s+(?:by|on)\s+)?(?P<col>.+?)\s+(?:in)?to\s+(?:separate\s+|one\s+)?rows?(?P<rest>.*)$", t, re.I) \
+            or re.match(r"(?:make\s+)?one\s+row\s+(?:per|for\s+each)\s+(?P<col>.+?)(?P<rest>(?:\s+(?:sharing|and|dividing|splitting|keeping|repeating).*)?)$", t, re.I)
+        if not m:
+            return None
+        rest = m.group("rest") or ""
+        table, col_spec = self._table_tail(m.group("col"))
+        keep = re.search(r"\bkeeping\s+(?P<k>.+?)\s+(?:together|as\s+one)\b", rest, re.I)
+        keep_together = self.split_values(keep.group("k")) if keep else []
+        if keep:
+            rest = rest[:keep.start()] + rest[keep.end():]
+        method = "equal_integer"
+        if re.search(r"\b(repeat|repeating|copy|copying)\b", rest, re.I):
+            method = "repeat"
+        elif re.search(r"\b(equally|evenly|as\s+decimals?)\b", rest, re.I) and not re.search(r"total|whole|integer", rest, re.I):
+            method = "equal"
+        sh = re.search(r"\b(?:sharing|share|and\s+share|dividing|divide|and\s+divide|splitting|allocating|repeating|copying)\s+(?P<c>.+?)"
+                       r"(?:\s+(?:equally|evenly|keeping.*|as\s+.*|by\s+.*))?$", rest.strip(), re.I)
+        if not table and sh:
+            table, _ = self._table_tail(sh.group("c"))
+        alloc = self.columns(re.sub(r"\s+(?:equally|evenly)$", "", self._table_tail(sh.group("c"))[1], flags=re.I)) if sh else []
+        if not table:
+            table, rest2 = self._table_tail(rest)
+        return Plan(ops=[SplitRows(table=table, column=self.column(col_spec), allocate=alloc, method=method,
+                                   keep_together=keep_together)])
+
+    def _split_column(self, t: str) -> Plan | None:
+        m = re.match(r"split\s+(?:the\s+)?(?:column\s+)?(?P<col>.+?)\s+into\s+(?P<into>.+?)(?:\s+(?:by|on|at|using|with|separated\s+by)\s+(?P<sep>.+))?$", t, re.I)
+        if not m or re.search(r"\brows?\b", m.group("into"), re.I):
+            return None
+        col = self.ctx.find_column(m.group("col"))
+        if col is None:
+            return None
+        into = self.split_values(m.group("into"))
+        if len(into) < 2:
+            raise self.Ask(f"Name at least two new columns, e.g. 'split {col} into First and Last'.")
+        sep_raw = (m.group("sep") or "space").strip()
+        word = re.sub(r"^(?:a|the|each)\s+", "", sep_raw.lower()).rstrip("s") if not re.match(r"['\"]", sep_raw) else None
+        if word is not None and (word in SEPARATOR_WORDS or word + "s" in SEPARATOR_WORDS):
+            sep = SEPARATOR_WORDS.get(word) or SEPARATOR_WORDS[word + "s"]
+        else:
+            sep = self.unquote(sep_raw)
+        return Plan(ops=[SplitColumn(column=col, into=into, separator=sep)])
+
+    def _allocate(self, t: str) -> Plan | None:
+        m = re.match(r"(?:allocate|share|distribute|split)\s+(?P<cols>.+?)\s+(?:across|by|over)\s+(?P<cat>.+?)\s+from\s+(?P<tab>.+?)"
+                     r"(?:\s+(?:using|by|with)\s+(?P<share>.+?))?\s+(?:matching|on|where|joining)\s+(?P<keys>.+?)(?P<int>\s+as\s+whole\s+numbers|\s+as\s+integers)?"
+                     r"(?P<keep>\s+keeping\s+unmatched\s+\w+)?$", t, re.I)
+        if not m:
+            return None
+        share_table = self._table(m.group("tab"))
+        table = None
+        cols_spec = m.group("cols")
+        table, cols_spec = self._table_tail(cols_spec)
+        pairs = self._pairs(m.group("keys"))
+        if table is None:
+            others = [n for n in self.ctx.table_names if n != share_table]
+            table = others[0] if len(others) == 1 else None
+        return Plan(ops=[AllocateByShare(table=table, share_table=share_table, on=pairs, category=self.unquote(m.group("cat")),
+                                         share=self.unquote(m.group("share")) if m.group("share") else None,
+                                         columns=self.columns(cols_spec), integer=bool(m.group("int")),
+                                         keep_unmatched_shares=bool(m.group("keep")))])
+
+    # ── grouping ─────────────────────────────────────────────────────────────
+    def _aggregate(self, t: str) -> Plan | None:
+        m = re.match(r"(?:count|number\s+of)\s+(?:the\s+)?(?:rows|records|orders|lines)?\s*(?:by|per|for\s+each)\s+(?P<by>.+?)\s+as\s+(?P<name>.+)$", t, re.I)
+        if m:
+            table, by = self._table_tail(m.group("by"))
+            return Plan(ops=[Aggregate(table=table, by=self.columns(by), count_as=self.unquote(m.group("name")))])
+        m = re.match(r"(?P<verb>sum|add\s+up|total|aggregate|average|mean)\s+(?:the\s+|up\s+)?(?P<cols>.+?)\s+(?:by|per|for\s+each|grouped\s+by)\s+(?P<by>.+?)$", t, re.I) \
+            or re.match(r"group\s+(?:the\s+rows\s+)?by\s+(?P<by>.+?)\s+and\s+(?P<verb>sum|add\s+up|total|average)\s+(?P<cols>.+)$", t, re.I)
+        if not m:
+            return None
+        table, by = self._table_tail(m.group("by"))
+        if table is None:
+            table, spec = self._table_tail(m.group("cols"))
+        else:
+            spec = m.group("cols")
+        cols = self.columns(spec)
+        mean = m.group("verb").lower() in ("average", "mean")
+        return Plan(ops=[Aggregate(table=table, by=self.columns(by), **({"mean": cols} if mean else {"sum": cols}))])
+
+    def _others(self, t: str) -> Plan | None:
+        m = re.match(r"(?:label|group|bucket|put|mark|call|relabel|rename)\s+(?:the\s+)?(?:other\s+|unknown\s+|remaining\s+)?(?P<col>.+?)\s+(?:values\s+)?"
+                     r"(?:(?:not\s+(?:in|on)\s+(?:the\s+)?(?:list\s+)?(?P<keep>.+?))|(?:outside\s+(?:the\s+)?top\s+(?P<top>\d+)))"
+                     r"\s+(?:as|into|under)\s+(?P<label>\S+?|\"[^\"]+\"|'[^']+')(?P<rest>(?:\s+(?:also|and|then|,).*)?)$", t, re.I)
+        if not m:
+            m2 = re.match(r"keep\s+(?:the\s+)?top\s+(?P<top>\d+)\s+(?P<col>.+?)(?:,|\s+and)\s+(?:the\s+)?(?:others|rest)\s+(?:as|into)\s+(?P<label>\S+)(?P<rest>.*)$", t, re.I)
+            if not m2:
+                return None
+            m = m2
+        rest = m.group("rest") or ""
+        table, col_spec = self._table_tail(m.group("col"))
+        col = self.column(col_spec)
+        keep, keep_from = None, None
+        if m.groupdict().get("keep"):
+            k = m.group("keep")
+            ref = self.ctx.find_table(re.sub(r"\s+(?:table|sheet|list)$", "", k, flags=re.I))
+            if ref is not None and ref != table:
+                keep_from = {"table": ref, "column": col}
+            else:
+                keep = self.split_values(k)
+        also = []
+        ma = re.search(r"\balso\s+(?:set\s+|label\s+)?(?P<a>.+?)(?=\s+then\b|$)", rest, re.I)
+        if ma:
+            also = self.columns(ma.group("a"))
+        sum_by, sums = None, []
+        ms = re.search(r"\b(?:then\s+)?(?:sum|add\s+up|total)\s+(?P<s>.+?)\s+(?:by|per)\s+(?P<b>.+)$", rest, re.I)
+        if ms:
+            sums, sum_by = self.columns(ms.group("s")), self.columns(ms.group("b"))
+        return Plan(ops=[BucketOthers(table=table, column=col, keep=keep, keep_from=keep_from,
+                                      top_n=int(m.group("top")) if m.groupdict().get("top") else None,
+                                      label=self.unquote(m.group("label")), also=also, sum_by=sum_by, sum=sums)])
+
+    def _net(self, t: str) -> Plan | None:
+        m = re.match(r"net\s+(?:the\s+|off\s+)?(?:next[- ]month(?:'s)?\s+)?(?:negative\s+)?(?:negatives\s+|returns?\s+|values?\s+)?(?:in|of|for)?\s*"
+                     r"(?P<val>.+?)\s+(?:by|per|across)\s+(?P<per>.+?)(?:\s+(?:per|for\s+each|by|grouped\s+by)\s+(?P<by>.+))?$", t, re.I)
+        if not m:
+            return None
+        table, val = self._table_tail(m.group("val"))
+        val = re.sub(r"^(?:negatives?|returns?)\s+(?:in|of)\s+", "", val, flags=re.I)
+        by = m.group("by") or ""
+        if by and table is None:
+            table, by = self._table_tail(by)
+        return Plan(ops=[NetNextPeriod(table=table, value=self.column(val), period=self.column(m.group("per")),
+                                       group_by=self.columns(by) if by else [])])
+
+    # ── combining tables ─────────────────────────────────────────────────────
+    def _append(self, t: str) -> Plan | None:
+        m = re.match(r"(?:append|stack|add|put|combine)\s+(?:the\s+)?(?:rows\s+(?:of|from)\s+)?(?P<src>.+?)\s+(?:to|under|below|onto|into|after)\s+(?P<dst>.+?)"
+                     r"(?:\s+(?:only\s+)?where\s+(?P<cond>.+?))?(?:\s+(?:renaming|mapping|with\s+columns?)\s+(?P<map>.+))?$", t, re.I)
+        if not m:
+            return None
+        src, dst = self.ctx.find_table(m.group("src")), self.ctx.find_table(m.group("dst"))
+        if src is None or dst is None:
+            if src is None and dst is None:
+                return None
+            raise self.Ask(f"Which tables? The tables are: {', '.join(self.ctx.table_names)}.")
+        rename = self._pairs(m.group("map")) if m.group("map") else {}
+        conds = []
+        if m.group("cond"):
+            conds = self.conditions(m.group("cond"))
+        return Plan(ops=[AppendRows(table=dst, source=src, rename=rename, where=conds)])
+
+    def _lookup(self, t: str) -> Plan | None:
+        m = re.match(r"(?:look\s*up|bring\s+in|fetch|get|join|pull\s+in|add)\s+(?P<cols>.+?)\s+from\s+(?P<tab>.+?)\s+(?:matching|on|by|where|using)\s+(?P<keys>.+?)"
+                     r"(?:\s+(?:into|for|in)\s+(?P<dst>[^,]+?))?(?P<first>\s+\(?(?:take|keep|use)\s+the\s+first\)?)?$", t, re.I)
+        if not m:
+            return None
+        lookup = self.ctx.find_table(m.group("tab"))
+        if lookup is None:
+            return None
+        dst = self._table(m.group("dst")) if m.group("dst") else None
+        pairs = self._pairs(m.group("keys"))
+        from ..selectors import find_column
+        for a, b in pairs.items():
+            if self.ctx.find_column(a) is None:
+                raise self.Ask(f"I could not find a column called '{a}' to match on.")
+            if find_column(b, self.ctx.columns_of(lookup)) is None:
+                raise self.Ask(f"{lookup} has no column '{b}'. Its columns are: {', '.join(self.ctx.columns_of(lookup))}.")
+        if dst is None:
+            others = [n for n in self.ctx.table_names if n != lookup]
+            dst = others[0] if len(others) == 1 else None
+        return Plan(ops=[LookupJoin(table=dst, lookup=lookup, on=pairs, columns=self.split_values(m.group("cols")),
+                                    duplicates="first" if m.group("first") else "mean")])
+
+    # ── values ───────────────────────────────────────────────────────────────
+    def _currency(self, t: str) -> Plan | None:
+        m = re.match(r"convert\s+(?P<cols>.+?)\s+from\s+(?P<a>[A-Za-z$€£₹]{1,3})\s+to\s+(?P<b>[A-Za-z$€£₹]{1,3})\s+(?:at|using|with\s+(?:a\s+)?rate(?:\s+of)?|rate)\s+(?P<rest>.+)$", t, re.I)
+        if not m:
+            return None
+        table, cols = self._table_tail(m.group("cols"))
+        rest = m.group("rest")
+        note = f"{m.group('a').upper()} -> {m.group('b').upper()}"
+        quarters = re.findall(r"([\d.,]+)\s+(?:for|in)\s+Q([1-4])\s*[-' ]?\s*(\d{2,4})", rest, re.I)
+        if quarters:
+            dm = re.search(r"\b(?:using|by|on|from)\s+(?:the\s+)?(?:date\s+(?:in\s+)?)?(?P<d>[^,]+?)(?:\s+column)?$", rest, re.I)
+            if not dm:
+                raise self.Ask("Which column holds the date that picks the rate? e.g. '… using Date'.")
+            rates = []
+            for rate, q, y in quarters:
+                yy = int(y) + (2000 if len(y) == 2 else 0)
+                lo = date(yy, 3 * int(q) - 2, 1)
+                hi = date(yy + (q == "4"), 1 if q == "4" else 3 * int(q) + 1, 1)
+                rates.append({"from": lo.isoformat(), "to": date.fromordinal(hi.toordinal() - 1).isoformat(),
+                              "rate": float(rate.replace(",", ""))})
+            return Plan(ops=[ConvertCurrency(table=table, columns=self.columns(cols), rates=rates,
+                                             date_column=self.column(dm.group("d")), note=note)])
+        rate = self.parse_number(rest.split()[0])
+        if rate is None:
+            raise self.Ask("What rate? e.g. 'convert Spend from USD to INR at 83.2', or per quarter: "
+                           "'at 86.5 for Q1 2025, 85 for Q2 2025 using Date'.")
+        return Plan(ops=[ConvertCurrency(table=table, columns=self.columns(cols), rate=rate, note=note)])
+
+    def _sort(self, t: str) -> Plan | None:
+        m = re.match(r"(?:sort|order|arrange)\s+(?:the\s+)?(?:rows\s+(?:of\s+)?)?(?:(?P<tab>.+?)\s+)?by\s+(?P<keys>.+)$", t, re.I)
+        if not m:
+            return None
+        table = self._table(m.group("tab")) if m.group("tab") else None
+        keys_spec = m.group("keys")
+        if table is None:
+            table, keys_spec = self._table_tail(keys_spec)
+        by, desc = [], []
+        for part in re.split(r"\s*,\s*(?:then\s+)?(?:and\s+)?|\s+then\s+|\s+and\s+", keys_spec):
+            d = bool(re.search(r"\s+(?:desc(?:ending)?|newest\s+first|latest\s+first|largest\s+first|highest\s+first|z\s*-\s*a)$", part, re.I))
+            name = re.sub(r"\s+(?:asc(?:ending)?|desc(?:ending)?|newest\s+first|latest\s+first|largest\s+first|highest\s+first|oldest\s+first|smallest\s+first|a\s*-\s*z|z\s*-\s*a)$", "", part, flags=re.I)
+            if name.strip():
+                by.append(self.column(name))
+                desc.append(d)
+        return Plan(ops=[SortRows(table=table, by=by, descending=desc)])
+
+    def _make_date(self, t: str) -> Plan | None:
+        m = re.match(r"(?:make|build|create|add|derive)\s+(?:a\s+|the\s+)?(?:(?P<name>\S+)\s+)?(?:date\s+)?(?:column\s+)?from\s+(?P<m>.+?)\s+and\s+(?P<d>.+)$", t, re.I)
+        if not m or "date" not in t.lower():
+            return None
+        table, d = self._table_tail(m.group("d"))
+        name = self.unquote(m.group("name")) if m.group("name") and m.group("name").lower() not in ("a", "the", "date") else "Date"
+        return Plan(ops=[MakeDate(table=table, month=self.column(m.group("m")), day=self.column(d), name=name)])
+
+    def _make_period(self, t: str) -> Plan | None:
+        m = re.match(r"add\s+(?:a\s+)?(?:column\s+)?(?P<name>.+?)\s+(?:as|=|with)\s+(?:the\s+)?(?P<unit>month|quarter|year|week)\s+(?:of|from)\s+(?P<col>.+)$", t, re.I) \
+            or re.match(r"add\s+the\s+(?P<unit>month|quarter|year|week)\s+of\s+(?P<col>.+?)\s+as\s+(?P<name>.+)$", t, re.I)
+        if not m:
+            return None
+        table, col = self._table_tail(m.group("col"))
+        return Plan(ops=[MakePeriod(table=table, column=self.column(col), unit=m.group("unit").lower(),
+                                    name=self.unquote(m.group("name")))])
+
+    def _drop(self, t: str) -> Plan | None:
+        m = re.match(r"(?:drop|remove|exclude|leave\s+out)\s+(?:the\s+)?table\s+(?P<t>.+)$", t, re.I)
+        if m:
+            return Plan(ops=[DropTable(table=self._table(m.group("t")))])
+        m = re.match(r"(?:drop|remove|delete)\s+(?:the\s+)?columns?\s+(?P<c>.+?)$", t, re.I)
+        if m:
+            table, cols = self._table_tail(m.group("c"))
+            return Plan(ops=[DropColumns(table=table, columns=self.columns(cols))])
+        return None
+
+    def _classify(self, t: str) -> Plan | None:
+        m = re.match(r"(?:set|make|add(?:\s+(?:a\s+)?column)?|create(?:\s+(?:a\s+)?column)?|classify)\s+(?P<col>[^,]+?)\s*(?:to|=|as|:)?\s+(?P<body>[^,]+?\s+if\s+.+)$", t, re.I)
+        if not m:
+            return None
+        body = m.group("body")
+        default, keep = None, False
+        md = re.search(r"[,;]?\s*(?:else|otherwise)\s+(?P<d>.+)$", body, re.I)
+        if md:
+            d = md.group("d").strip()
+            body = body[:md.start()]
+            if re.fullmatch(r"(?:keep|leave)\s+(?:it|as\s+is|the\s+(?:current|existing)\s+value)", d, re.I):
+                keep = True
+            else:
+                default = None if d.lower() in ("empty", "blank", "null", "nothing") else self.unquote(d)
+        rules = []
+        for part in re.split(r"\s*[,;]\s*(?=[^,;]+?\s+if\s+)", body.strip()):
+            pm = re.match(r"(?P<v>.+?)\s+if\s+(?P<c>.+)$", part.strip(), re.I)
+            if not pm:
+                return None
+            rules.append(Rule(value=self.unquote(pm.group("v").strip()), when=self.conditions(pm.group("c"))))
+        table, col = self._table_tail(m.group("col"))
+        return Plan(ops=[Classify(column=self.unquote(col.strip()), rules=rules, default=default, keep_existing=keep,
+                                  tables=[table] if table else None)])
+
+
+COLUMN_FIELDS = ("column", "columns", "by", "sum", "mean", "first", "month", "day", "period", "group_by", "index",
+                 "columns_from", "values_from", "allocate")
+
+
+def infer_table(op, ctx) -> None:
+    """Phase T: a step that names no table goes to the one table that has every column it uses (if exactly one)."""
+    if getattr(op, "table", "x") is not None or ctx.phase != "T" or len(ctx.tables) < 2:
+        return
+    used: list[str] = []
+    for f in COLUMN_FIELDS:
+        v = getattr(op, f, None)
+        if op.op == "net_next_period" and f == "column":
+            continue
+        used += [v] if isinstance(v, str) else list(v or []) if isinstance(v, list) else []
+    if op.op == "net_next_period":
+        used.append(op.value)
+    if not used:
+        return
+    from src.hygiene.cities import normalize
+    hits = [t.ref for t in ctx.tables if all(any(normalize(c) == normalize(x) for x in t.cols) for c in used)]   # exact names
+    if len(hits) == 1:
+        op.table = hits[0]
+
+
+def _stem(cols: list[str]) -> str:
+    """'Day 1'..'Day 31' -> 'Day': the shared leading word(s) of the columns, else 'Variable'."""
+    first = re.match(r"^(.*?)[\s_-]*\d+$", cols[0])
+    if first and all(c.startswith(first.group(1)) for c in cols) and first.group(1).strip():
+        return first.group(1).strip()
+    return "Variable"
diff --git a/src/agent/recipes.py b/src/agent/recipes.py
new file mode 100644
index 0000000..e23c4af
--- /dev/null
+++ b/src/agent/recipes.py
@@ -0,0 +1,86 @@
+"""Saved recipes: named lists of typed steps, shared by every run, so next month's file gets this month's fixes and
+transformations in one previewed change.
+
+    <workspace>/../recipes/<slug>.json   {"name", "phase", "steps": [operation, ...], "saved_from"}
+
+A recipe belongs to the phase it was built in. Phase B recipes are the value fixes of a run's applied change-sets,
+without the steps that name Excel row numbers (row 14 of this month's file is a different row next month). Phase T
+recipes are the transformation recipe itself.
+"""
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+
+from pydantic import TypeAdapter
+
+from .errors import AgentError
+from .operations import Operation
+
+OPS = TypeAdapter(list[Operation])
+
+
+def _slug(name: str) -> str:
+    return re.sub(r"[^A-Za-z0-9_-]+", "_", name.strip()).strip("_")[:60].lower()
+
+
+def row_specific(op) -> bool:
+    """A step that names Excel rows: it fits this file only."""
+    where = getattr(op, "where", None)
+    return bool(where is not None and hasattr(where, "rows") and (where.rows or where.exclude_rows))
+
+
+def replayable(ops: list) -> tuple[list, list]:
+    """(steps that can run on another file, steps that cannot)."""
+    keep = [op for op in ops if not row_specific(op)]
+    return keep, [op for op in ops if row_specific(op)]
+
+
+class RecipeLibrary:
+    def __init__(self, folder: Path | str | None):
+        self.folder = Path(folder) if folder else None
+
+    def _path(self, name: str) -> Path:
+        if self.folder is None:
+            raise AgentError("no_library", "Saving recipes is not set up for this service.")
+        slug = _slug(name)
+        if not slug:
+            raise AgentError("bad_name", "Give the recipe a name made of letters or digits.")
+        return self.folder / f"{slug}.json"
+
+    def entries(self) -> list[dict]:
+        if self.folder is None or not self.folder.exists():
+            return []
+        out = []
+        for p in sorted(self.folder.glob("*.json")):
+            try:
+                d = json.loads(p.read_text("utf8"))
+            except (OSError, ValueError):
+                continue
+            out.append({"name": d.get("name", p.stem), "phase": d.get("phase", "T"), "steps": len(d.get("steps", []))})
+        return out
+
+    def names(self, phase: str | None = None) -> list[str]:
+        return [e["name"] for e in self.entries() if phase is None or e["phase"] == phase]
+
+    def save(self, name: str, ops: list[dict], source: str, phase: str = "T") -> Path:
+        p = self._path(name)
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text(json.dumps({"name": name.strip(), "phase": phase, "steps": ops, "saved_from": source}, indent=1,
+                                default=str), encoding="utf8")
+        return p
+
+    def load(self, name: str, phase: str | None = None) -> list:
+        p = self._path(name)
+        if not p.exists():
+            have = self.names(phase)
+            raise AgentError("no_such_recipe", f"There is no saved recipe '{name}'."
+                             + (f" Saved recipes here: {', '.join(have)}." if have else " None is saved for this phase yet."))
+        data = json.loads(p.read_text("utf8"))
+        built_in = data.get("phase", "T")
+        if phase is not None and built_in != phase:
+            where = {"T": "a reshaping recipe; use it with Reshape with agent on Phase A's review",
+                     "B": "a recipe of value fixes; use it with Fix with agent on Phase B's review"}.get(built_in, f"a Phase {built_in} recipe")
+            raise AgentError("wrong_phase", f"'{data.get('name', name)}' is {where}.")
+        return OPS.validate_python(data["steps"])
diff --git a/src/agent/registry.py b/src/agent/registry.py
new file mode 100644
index 0000000..d6e13ad
--- /dev/null
+++ b/src/agent/registry.py
@@ -0,0 +1,117 @@
+"""The tool registry: the one place that says what the agent can do.
+
+Each `Tool` ties together everything that used to be spread over five files: the typed input model
+(`operations.py`), the phases it may run in, how risky it is, whether it takes a row filter, and the sentence the
+local model reads about it. From this registry the planner builds the model's prompt and JSON schema, the
+guardrails decide which changes need a second confirmation, the help text lists what is possible, and
+`mcp_tools()` exports the same definitions in Model Context Protocol shape (name, description, inputSchema), so an
+MCP adapter can be added later without describing the tools a second time.
+
+Adding an operation = its pydantic model in `operations.py`, its executor in `executors.py` and/or
+`transform/engine.py`, and one `Tool` here. `tests/test_agent_registry.py` fails if the three disagree.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from pydantic import BaseModel
+
+from . import operations as ops
+
+Risk = Literal["low", "medium", "high"]
+PHASES = ("B", "T")
+
+
+@dataclass(frozen=True)
+class Tool:
+    name: str
+    model: type[BaseModel]
+    phases: frozenset[str]            # where it may run: "B" (value fixes on checked data), "T" (transformations)
+    risk: Risk                        # low: adds or annotates; medium: rewrites values; high: removes rows/columns/tables
+    row_filter: bool                  # takes `where` (tables / rows / exclude_rows / conditions)
+    summary: str                      # what the local model is told about it (also the MCP description)
+
+    @property
+    def fields(self) -> set[str]:
+        return set(self.model.model_fields)
+
+
+def _tool(model, phases: str, risk: Risk, summary: str, row_filter: bool = False) -> Tool:
+    return Tool(model.model_fields["op"].default, model, frozenset(phases), risk, row_filter, " ".join(summary.split()))
+
+
+_ALL = [
+    _tool(ops.ResolveFindings, "B", "medium", """answer open review items. decision = accept (take the proposed fix) |
+          reject (restore the original value) | keep (leave the value, close the item) | set (write new_value) |
+          split (one row per value, D-29 only). Narrow with rules (codes like "D-02"), column, value, rows (Excel row
+          numbers), exclude_rows, conditions.""", row_filter=True),
+    _tool(ops.SetValue, "BT", "medium", """write `value` into `column` for the rows chosen by rows / exclude_rows /
+          conditions (value null = empty).""", row_filter=True),
+    _tool(ops.ReplaceValues, "BT", "medium", """`mapping` of whole cell values to new values (null = empty) in
+          `columns`.""", row_filter=True),
+    _tool(ops.ReplaceText, "BT", "medium", """replace the text `find` with `replace` inside cells of `column`
+          (regex=true for a pattern).""", row_filter=True),
+    _tool(ops.Scale, "BT", "medium", """multiply `columns` by `factor` (thousands = 1000; to divide by 100 use 0.01).""",
+          row_filter=True),
+    _tool(ops.AddColumn, "BT", "low", """new column `name` with either `value` (same on every row), or `from_column` +
+          `mapping` (+ `default`), or `formula` over columns and numbers with + - * / and brackets."""),
+    _tool(ops.RenameColumn, "BT", "low", "`column` -> `new_name`."),
+    _tool(ops.RemoveRows, "BT", "high", "remove rows chosen by rows / conditions (never every row).", row_filter=True),
+    _tool(ops.SplitColumn, "BT", "low", """split `column` into the new columns `into` on `separator` (or regex
+          `pattern` with groups)."""),
+    _tool(ops.Classify, "BT", "low", """if / else into `column`: `rules` = [{"when": [conditions], "value": ...}], first
+          match wins; `default`."""),
+    _tool(ops.Unpivot, "T", "medium", """`columns` (or regex `pattern`) become rows; names into `names_to`, values into
+          `values_to`."""),
+    _tool(ops.Pivot, "T", "medium", """values of `columns_from` become columns holding `values_from` (`agg`
+          sum|mean|first|count), one row per `index`."""),
+    _tool(ops.SplitRows, "T", "medium", """one row per item of the list in `column`; `allocate` number columns
+          (`method` equal_integer|equal|repeat)."""),
+    _tool(ops.AllocateByShare, "T", "medium", """share `columns` across `category` rows of `share_table` (`share`
+          column or equal), keys `on`."""),
+    _tool(ops.Aggregate, "T", "high", "group `by`, `sum` / `mean` / `first` columns, `count_as` a row count."),
+    _tool(ops.BucketOthers, "T", "medium", """`column` values not in `keep` (or `keep_from` {table, column}, or outside
+          `top_n`) become `label`."""),
+    _tool(ops.NetNextPeriod, "T", "medium", """`value` per `group_by` and month of `period`: next month's negative nets
+          this month's allocation."""),
+    _tool(ops.AppendRows, "T", "medium", """rows of `source` under `table` (`rename` source->target columns, `where`
+          conditions on the source)."""),
+    _tool(ops.LookupJoin, "T", "low", """bring `columns` from `lookup` where keys `on` (this table's column -> lookup's
+          column) match."""),
+    _tool(ops.ConvertCurrency, "T", "medium", """`columns` x `rate`, or `rates` [{"from","to","rate"}] by
+          `date_column`."""),
+    _tool(ops.SortRows, "T", "low", "sort `by` (+ `descending`)."),
+    _tool(ops.MakeDate, "T", "low", "a date column `name` from `month` and `day` columns."),
+    _tool(ops.MakePeriod, "T", "low", "column `name` = the `unit` (month|quarter|year|week) that `column`'s date falls in."),
+    _tool(ops.DropColumns, "T", "high", "leave `columns` out of the final data."),
+    _tool(ops.DropTable, "T", "high", "leave `table` out of the final data."),
+]
+TOOLS: dict[str, Tool] = {t.name: t for t in _ALL}
+
+
+def tools_for(phase: str) -> list[Tool]:
+    """The tools a phase offers, in catalogue order."""
+    return [t for t in TOOLS.values() if phase in t.phases]
+
+
+def names_for(phase: str) -> list[str]:
+    return [t.name for t in tools_for(phase)]
+
+
+def get(name: str) -> Tool:
+    return TOOLS[name]
+
+
+def prompt_catalogue(phase: str) -> str:
+    """The operation list of the model's system prompt: only what this phase can run."""
+    return "\n".join(f"- {t.name}: {t.summary}" for t in tools_for(phase))
+
+
+def mcp_tools(phase: str | None = None) -> list[dict]:
+    """The registry in Model Context Protocol shape. Calling one of these through any adapter must create a
+    *proposal* (a previewed change-set), never an applied change: applying stays a person's click."""
+    chosen = TOOLS.values() if phase is None else tools_for(phase)
+    return [{"name": f"dq_propose_{t.name}", "description": t.summary, "inputSchema": t.model.model_json_schema(),
+             "annotations": {"risk": t.risk, "phases": sorted(t.phases), "destructiveHint": t.risk == "high",
+                             "readOnlyHint": False}} for t in chosen]
diff --git a/src/agent/safe_regex.py b/src/agent/safe_regex.py
new file mode 100644
index 0000000..5b906af
--- /dev/null
+++ b/src/agent/safe_regex.py
@@ -0,0 +1,61 @@
+"""Regular expressions that come from an analyst or the model, made safe to run on client data.
+
+Python's `re` backtracks without limit: a pattern such as `(a+)+$` on a 33-character cell runs for minutes, and an
+apply job would hold a worker until the job timeout. Every pattern from outside therefore goes through here:
+
+  * it must be short (`MAX_PATTERN_LEN`) and must compile;
+  * each match runs with a time limit (`MATCH_TIMEOUT_S`, the `regex` library's `timeout`);
+  * the first cell that hits the limit aborts the whole operation with a message the analyst can act on.
+
+Phase T's engine matches with Polars (Rust regex, linear time) and only needs `check`.
+"""
+from __future__ import annotations
+
+from functools import lru_cache
+
+import regex
+
+from .errors import AgentError
+
+MAX_PATTERN_LEN = 500
+MATCH_TIMEOUT_S = 0.25
+
+
+class SafePattern:
+    def __init__(self, pattern: str, ignore_case: bool = False):
+        if len(pattern) > MAX_PATTERN_LEN:
+            raise AgentError("bad_pattern", f"The pattern is longer than {MAX_PATTERN_LEN} characters; use a simpler one.")
+        try:
+            self._rx = regex.compile(pattern, regex.IGNORECASE if ignore_case else 0)
+        except regex.error as e:
+            raise AgentError("bad_pattern", f"The pattern '{pattern}' is not valid: {e}") from e
+        self.pattern = pattern
+
+    def _slow(self) -> AgentError:
+        return AgentError("pattern_too_slow", f"The pattern '{self.pattern}' takes too long on this data (it backtracks "
+                                              "heavily). Use a simpler pattern, for example without nested repeats.")
+
+    def search(self, text: str):
+        try:
+            return self._rx.search(text, timeout=MATCH_TIMEOUT_S)
+        except TimeoutError:
+            raise self._slow() from None
+
+    def sub(self, repl: str, text: str) -> str:
+        try:
+            return self._rx.sub(repl, text, timeout=MATCH_TIMEOUT_S)
+        except TimeoutError:
+            raise self._slow() from None
+        except (regex.error, IndexError) as e:               # a replacement that names a group the pattern lacks
+            raise AgentError("bad_pattern", f"The replacement '{repl}' does not fit the pattern: {e}") from e
+
+
+@lru_cache(maxsize=256)
+def compiled(pattern: str, ignore_case: bool = False) -> SafePattern:
+    """Compile once per pattern (conditions are evaluated cell by cell)."""
+    return SafePattern(pattern, ignore_case)
+
+
+def check(pattern: str) -> None:
+    """Length and syntax only, for engines that match in linear time themselves."""
+    compiled(pattern)
diff --git a/src/agent/selectors.py b/src/agent/selectors.py
new file mode 100644
index 0000000..791b2d5
--- /dev/null
+++ b/src/agent/selectors.py
@@ -0,0 +1,153 @@
+"""Which tables, columns and rows a change touches.
+
+Names are never exact in client files ('city' vs 'City_Name', 'Spend (INR)'), so column names go through the same
+matching Phase B uses for expected columns (case, spaces, punctuation, whole words, one or two typos). A name that
+matches nothing, or more than one column, is an error the planner turns into a question; it is never guessed.
+"""
+from __future__ import annotations
+
+from fnmatch import fnmatch
+
+from src.hygiene.cities import normalize
+from src.hygiene.rules import find_expected_columns
+from src.hygiene.table import Table
+from src.hygiene.values import parse_date, parse_number
+
+from . import safe_regex
+from .errors import AgentError
+from .operations import Condition, RowFilter, value_list
+from .tables import PlanTable
+
+
+def text_key(v) -> str:
+    """How values are compared in conditions and mappings: trimmed, inner spaces collapsed, case-folded."""
+    return " ".join(str(v).split()).casefold()
+
+
+def table_matches(t: Table, patterns: list[str] | None) -> bool:
+    """A table is chosen by its ref, file name or sheet name: part of the name, or a glob ('coupon_*')."""
+    if not patterns:
+        return True
+    names = [x for x in (t.ref, t.source_file, t.sheet) if x]
+    for p in patterns:
+        pk = text_key(p)
+        for n in names:
+            nk = text_key(n)
+            if pk == nk or pk in nk or fnmatch(nk, pk) or fnmatch(nk.rsplit("/", 1)[-1], pk):
+                return True
+    return False
+
+
+def find_column(name: str, columns: list[str]) -> str | None:
+    """The column `name` means, or None. Exact, then ignoring case/spaces/punctuation, then Phase B's header matching."""
+    if name in columns:
+        return name
+    norm = normalize(name)
+    same = [c for c in columns if normalize(c) == norm]
+    if len(same) == 1:
+        return same[0]
+    hit = find_expected_columns([name], columns, {}).get(name)
+    return hit
+
+
+def column_in(t: Table, name: str) -> str | None:
+    return find_column(name, list(t.cols))
+
+
+def require_column(t: Table, name: str) -> str:
+    col = column_in(t, name)
+    if col is None:
+        raise AgentError("unknown_column", f"There is no column '{name}' in {label(t)}.")
+    return col
+
+
+def label(t: PlanTable) -> str:
+    parts = [p for p in (t.source_file, t.sheet) if p]
+    return " / ".join(parts) if parts else t.ref
+
+
+def _number(t: Table, col: str, v) -> float | None:
+    if v is None:
+        return None
+    if isinstance(v, (int, float)):
+        return float(v)
+    n = parse_number(str(v), t.cfg["currency_symbols"], t.eu(col))
+    return float(n) if n is not None else None
+
+
+def as_date(v) -> tuple | None:
+    """(y, m, d) when `v` is a date ('2025-09-09', '09/09/2025', a date object), else None."""
+    if v is None or isinstance(v, (int, float)):
+        return None
+    if hasattr(v, "year") and hasattr(v, "month"):
+        return (v.year, v.month, v.day)
+    status, ymd, _ = parse_date(str(v).strip()[:10], True, 1000, 3000)
+    return tuple(ymd) if status == "ok" and ymd else None
+
+
+def _test(t: Table, col: str, cond: Condition, v) -> bool:
+    op = cond.op
+    if op == "empty":
+        return v is None or str(v).strip() == ""
+    if op == "not_empty":
+        return not (v is None or str(v).strip() == "")
+    if op in ("gt", "gte", "lt", "lte"):
+        da, db = as_date(v), as_date(cond.value)
+        a: tuple | float | None
+        b: tuple | float | None
+        if db is not None:                                    # 'Date >= 2025-09-09' compares dates
+            a, b = da, db
+        else:
+            a, b = _number(t, col, v), _number(t, col, cond.value)
+        if a is None or b is None:
+            return False
+        return {"gt": a > b, "gte": a >= b, "lt": a < b, "lte": a <= b}[op]      # type: ignore[operator]  # same kind on both sides
+    if v is None:
+        return op in ("ne", "not_in")
+    key = text_key(v)
+    if op in ("eq", "ne"):
+        target = cond.value
+        equal = key == text_key(target)
+        if not equal and isinstance(target, (int, float)):        # 1000 matches "1,000" and "1000.0"
+            n = _number(t, col, v)
+            equal = n is not None and n == float(target)
+        return equal if op == "eq" else not equal
+    if op in ("in", "not_in"):
+        hit = key in {text_key(x) for x in value_list(cond.value)}
+        return hit if op == "in" else not hit
+    if op == "contains":
+        return text_key(cond.value) in key
+    if op == "starts_with":
+        return key.startswith(text_key(cond.value))
+    if op == "ends_with":
+        return key.endswith(text_key(cond.value))
+    if op == "matches":
+        return safe_regex.compiled(str(cond.value), True).search(str(v)) is not None
+    raise AgentError("bad_condition", f"Unknown condition '{op}'.")
+
+
+def rows(t: Table, where: RowFilter) -> list[int]:
+    """Row indexes (positions in the table) that the filter selects. Empty when the table itself is not chosen."""
+    if not table_matches(t, where.tables):
+        return []
+    n = len(t.data["_row_id"])
+    src = t.data.get("_source_row") or [None] * n
+    keep: list[int] = list(range(n))
+    if where.rows:
+        wanted = {int(r) for r in where.rows}
+        keep = [i for i in keep if src[i] in wanted]
+    if where.exclude_rows:
+        skip = {int(r) for r in where.exclude_rows}
+        keep = [i for i in keep if src[i] not in skip]
+    for cond in where.conditions:
+        col = column_in(t, cond.column)
+        if col is None:
+            return []                                    # the table does not have the column: nothing in it matches
+        vals = t.data[col]
+        keep = [i for i in keep if _test(t, col, cond, vals[i])]
+    return keep
+
+
+def tables_with_columns(tables: list[Table], where_tables: list[str] | None, columns: list[str]) -> list[Table]:
+    """Chosen tables that have every one of `columns`."""
+    return [t for t in tables if table_matches(t, where_tables) and all(column_in(t, c) for c in columns)]
diff --git a/src/agent/service.py b/src/agent/service.py
new file mode 100644
index 0000000..5c4a826
--- /dev/null
+++ b/src/agent/service.py
@@ -0,0 +1,250 @@
+"""The agent's use cases: what the worker process runs for each request.
+
+    message(text)   plan the instruction; a change becomes a stored, previewed change-set (nothing is changed)
+    apply(cs_id)    apply a previewed change-set (snapshot first, so it can be undone)
+    undo()          restore the snapshot of the last applied change-set
+    discard(cs_id)  drop a proposal
+    state()         the conversation and the change-sets, for the UI
+
+The service talks to a `Workspace` (the phase's data) and a `Planner`; it knows nothing about HTTP, jobs or which
+phase it serves. Errors the analyst can act on are AgentError; they become chat messages, not crashes.
+"""
+from __future__ import annotations
+
+import logging
+import re
+
+from . import guardrails
+from .errors import AgentError
+from .operations import Plan
+from .planner import Planner, PlanningContext
+from .recipes import RecipeLibrary, replayable
+from .store import AgentStore, ChangeSet, now
+from .workspace import Workspace
+
+log = logging.getLogger("dq.agent")
+HISTORY_MESSAGES = 12                             # stored messages looked at when building the model's memory
+UNDO_DEPTH = 10                                   # applied change-sets that keep a snapshot (older ones cannot be undone)
+
+
+class AgentService:
+    def __init__(self, workspace: Workspace | None, store: AgentStore, planner: Planner | None, library: RecipeLibrary | None = None,
+                 audit=None, run_id: str | None = None, confirm_cells: int = guardrails.CONFIRM_CELLS):
+        self._ws, self.store, self._planner = workspace, store, planner
+        self.library = library or getattr(workspace, "library", None) or RecipeLibrary(None)
+        self.audit, self.run_id, self.confirm_cells = audit, run_id, confirm_cells
+
+    @property
+    def ws(self) -> Workspace:
+        """The phase's data. Only `discard` works without one (it touches the proposal alone)."""
+        if self._ws is None:
+            raise AgentError("not_ready", "This action needs the phase's data, which is not loaded.")
+        return self._ws
+
+    @property
+    def planner(self) -> Planner:
+        if self._planner is None:
+            raise AgentError("not_ready", "No planner is configured for this action.")
+        return self._planner
+
+    def _audit(self, action: str, **detail) -> None:
+        if self.audit is not None:
+            self.audit.record(action, self.run_id, self.store.phase, **detail)
+
+    def _history(self) -> list[dict]:
+        """The conversation so far, for the model's memory: what was said, and for proposals the typed plan and what
+        became of it. The message being planned now is not part of it."""
+        sets = {c.id: c for c in self.store.all()}
+        turns = []
+        for m in self.store.messages()[-HISTORY_MESSAGES:]:
+            turn: dict = {"role": m.role, "text": m.text if m.role == "user" else m.text.split("\n", 1)[0]}
+            cs = sets.get(m.changeset) if m.kind == "proposal" and m.changeset else None
+            if cs is not None:
+                turn.update(ops=cs.plan, status=cs.status)
+            if m.kind in ("text", "proposal", "ask"):                   # results and errors add nothing to plan from
+                turns.append(turn)
+        return turns
+
+    # ── read ─────────────────────────────────────────────────────────────────
+    def state(self) -> dict:
+        css = self.store.all()
+        last = self.store.last_applied()
+        return {"messages": [m.model_dump() for m in self.store.messages()],
+                "changesets": {c.id: {**c.brief(), "preview": c.preview} for c in css},
+                "can_undo": bool(last and last.has_snapshot), "undo": last.brief() if last and last.has_snapshot else None}
+
+    # ── message ──────────────────────────────────────────────────────────────
+    def message(self, text: str) -> dict:
+        text = (text or "").strip()
+        if not text:
+            raise AgentError("empty_message", "Type what you would like to change.")
+        if len(text) > 2000:
+            raise AgentError("message_too_long", "Keep an instruction under 2,000 characters; split it into steps.")
+        history = self._history()                                # before this message is stored
+        user = self.store.add_message("user", text)
+        try:
+            plan = self._recipe_command(text)
+        except AgentError as e:
+            plan = Plan(answer=e.message)
+        if plan is None:
+            tables = self.ws.load()
+            plan = self.planner.plan(text, PlanningContext(tables, self.ws.phase, history))
+        llm = self.planner.llm
+        trace = dict(llm.trace) if llm is not None and plan.source == "llm" else None
+        kind = "ask" if plan.ask else "answer" if plan.answer else "plan"
+        log.info("agent plan", extra={"source": plan.source, "kind": kind, "operations": [op.op for op in plan.ops],
+                                      "chars": len(text)})
+        self._audit("agent.planned", source=plan.source, kind=kind, operations=[op.op for op in plan.ops],
+                    instruction_chars=len(text), model_calls=(trace or {}).get("calls", 0),
+                    repaired=(trace or {}).get("repaired", False))
+        if plan.ask:
+            reply = self.store.add_message("agent", plan.ask, "ask")
+            return {"messages": [user.model_dump(), reply.model_dump()], "changeset": None}
+        if plan.answer:
+            reply = self.store.add_message("agent", plan.answer, "answer")
+            return {"messages": [user.model_dump(), reply.model_dump()], "changeset": None}
+        cs_id = self.store.next_id()
+        version = self.ws.version()
+        try:
+            preview = self.ws.preview(plan.ops, cs_id, text)
+        except AgentError as e:
+            reply = self.store.add_message("agent", e.message, "error")
+            return {"messages": [user.model_dump(), reply.model_dump()], "changeset": None}
+        if not preview["changes_anything"]:
+            notes = [n for o in preview["operations"] for n in o["effect"]["notes"]]
+            unmatched = [u for o in preview["operations"] for u in o["effect"]["unmatched"]]
+            text_ = "Nothing would change. " + " ".join(o["text"] for o in preview["operations"])
+            if notes:
+                text_ += " " + " ".join(notes)
+            if unmatched:
+                text_ += f" Not found: {', '.join(map(str, unmatched[:10]))}."
+            reply = self.store.add_message("agent", text_, "answer")
+            return {"messages": [user.model_dump(), reply.model_dump()], "changeset": None}
+        review = guardrails.assess(plan.ops, preview, self.confirm_cells)
+        model = None
+        if trace is not None and llm is not None and llm.client is not None:
+            model = {"model": llm.client.model, "digest": llm.client.digest, "prompt_version": trace.get("prompt_version"),
+                     "repaired": trace.get("repaired", False)}
+        cs = ChangeSet(id=cs_id, phase=self.store.phase, instruction=text, source=plan.source,
+                       plan=[op.model_dump() for op in plan.ops], preview=preview, base_version=version,
+                       review=review, model=model)
+        self.store.save(cs)
+        caution = ("\nPlease check this one carefully before applying: " + " ".join(review["reasons"])
+                   if guardrails.needs_confirmation(review) else "")
+        reply = self.store.add_message("agent", "Here is what I would change. Nothing is applied until you click Apply.\n"
+                                       + "\n".join(f"• {o['text']} {o['summary']}" for o in preview["operations"]) + caution,
+                                       "proposal", cs_id)
+        return {"messages": [user.model_dump(), reply.model_dump()], "changeset": {**cs.brief(), "preview": preview}}
+
+    def _recipe_command(self, text: str) -> Plan | None:
+        """Recipe commands: save this run's steps to the library, list it, show the steps, or use a saved recipe (its
+        steps become an ordinary proposal: previewed, applied with a click). Phase T saves its transformation recipe;
+        Phase B saves the value fixes applied in this run that do not name Excel rows."""
+        t = " ".join(text.strip().rstrip(".!").split())
+        saving = re.fullmatch(r"(?:save|store|keep)\s+(?:this\s+|the\s+|these\s+)?(?:recipe|fixes|steps)\s+(?:as|named|called)\s+[\"']?(.+?)[\"']?", t, re.I)
+        using = re.fullmatch(r"(?:use|load|apply|run|reuse)\s+(?:the\s+)?(?:saved\s+)?recipe\s+[\"']?(.+?)[\"']?", t, re.I)
+        listing = re.fullmatch(r"(?:list|show)\s+(?:the\s+|my\s+|all\s+)?(?:saved\s+)?recipes", t, re.I)
+        showing = re.fullmatch(r"(?:show|list|what are)\s+(?:the\s+|my\s+)?(?:recipe|steps)(?:\s+so\s+far)?", t, re.I)
+        if not (saving or using or listing or showing):
+            return None
+        from . import describe
+        phase = self.ws.phase
+        if phase == "T":
+            steps: list = self.ws.recipe()
+            skipped: list = []
+        else:
+            applied = sorted((c for c in self.store.all() if c.status == "applied"), key=lambda c: (c.applied_at or "", c.id))
+            steps, skipped = replayable([op for c in applied for op in c.operations()])
+        if saving:
+            if not steps:
+                raise AgentError("empty_recipe", "There are no steps to save yet"
+                                 + (" (steps that name Excel rows are left out: they fit this file only)." if skipped else "."))
+            name = saving.group(1).strip()
+            self.library.save(name, [op.model_dump() for op in steps], self.store.phase, phase=phase)
+            note = f" {len(skipped)} step(s) naming Excel rows were left out: they fit this file only." if skipped else ""
+            return Plan(answer=f"Saved the recipe ({len(steps)} step(s)) as '{name}'.{note} Say \"use recipe {name}\" "
+                               "on another run to apply it.")
+        if listing:
+            entries = [e for e in self.library.entries() if e["phase"] == phase]
+            return Plan(answer=("Saved recipes for this phase: " + ", ".join(f"{e['name']} ({e['steps']} step(s))" for e in entries)
+                                + ". Say \"use recipe <name>\" to apply one.") if entries else
+                        "No recipe is saved for this phase yet. Apply some changes, then say \"save recipe as <name>\".")
+        if showing:
+            lines = [f"{n}. {describe.operation(op)}" for n, op in enumerate(steps, 1)]
+            extra = f"\n({len(skipped)} applied step(s) name Excel rows and would not be saved.)" if skipped else ""
+            return Plan(answer=("The steps a saved recipe would hold:\n" + "\n".join(lines) + extra) if lines else
+                        "No replayable steps yet." + extra)
+        assert using is not None                         # the only pattern left
+        return Plan(ops=self.library.load(using.group(1), phase), source="rules")
+
+    # ── apply ────────────────────────────────────────────────────────────────
+    def _proposal(self, cs_id: str) -> ChangeSet:
+        cs = self.store.get(cs_id)
+        if cs is None:
+            raise AgentError("no_such_changeset", f"There is no change {cs_id}.")
+        if cs.status != "proposed":
+            raise AgentError("not_proposed", f"Change {cs_id} is {cs.status}; only a proposed change can be applied.")
+        return cs
+
+    def _stale_others(self, keep: str | None) -> None:
+        for other in self.store.all():
+            if other.status == "proposed" and other.id != keep:
+                other.status = "stale"
+                self.store.save(other)
+
+    def apply(self, cs_id: str, confirm: bool = False, applied_by: str = "analyst") -> dict:
+        cs = self._proposal(cs_id)
+        if guardrails.needs_confirmation(cs.review) and not confirm:
+            raise AgentError("confirmation_required", "This change needs an explicit confirmation: "
+                             + " ".join((cs.review or {}).get("reasons", [])) + " Check the preview, then confirm.")
+        try:
+            result = self.ws.apply(cs.operations(), cs.id, cs.instruction, cs.base_version, self.store.snapshot_dir(cs.id))
+        except AgentError as e:
+            if e.code == "stale_proposal":
+                cs.status = "stale"
+            else:
+                cs.status, cs.error = "failed", e.message
+            self.store.save(cs)
+            self.store.add_message("agent", e.message, "error", cs.id)
+            raise
+        cs.status, cs.applied_at, cs.result, cs.has_snapshot, cs.applied_by = "applied", now(), result, True, applied_by
+        self.store.save(cs)
+        self._audit("agent.applied", changeset=cs.id, source=cs.source, operations=[op["op"] for op in cs.plan],
+                    confirmed=bool(confirm), elevated=guardrails.needs_confirmation(cs.review),
+                    cells=(cs.preview.get("totals") or {}).get("cells"), model=(cs.model or {}).get("model"))
+        self._stale_others(cs.id)                        # their previews were computed on the data before this change
+        self.store.prune_snapshots(UNDO_DEPTH)
+        tail = (f" The recipe now has {result['steps']} step(s)." if "steps" in result
+                else f" {result['open_items_after']} review item(s) are still open.")
+        summary = result["summary"].rstrip()
+        summary += "" if summary.endswith((".", "!", "?")) else "."
+        msg = self.store.add_message("agent", f"Applied {cs.id}: {summary}"
+                                     + (f" Phase B's rules then tidied {result['follow_up_fixes']} of the new values."
+                                        if result.get("follow_up_fixes") else "") + tail, "result", cs.id)
+        return {"changeset": cs.brief(), "message": msg.model_dump(), "result": result}
+
+    # ── undo / discard ───────────────────────────────────────────────────────
+    def undo(self) -> dict:
+        cs = self.store.last_applied()
+        if cs is None or not cs.has_snapshot:
+            raise AgentError("nothing_to_undo", "There is no applied change that can be undone.")
+        self.ws.restore(self.store.snapshot_dir(cs.id))
+        cs.status, cs.undone_at, cs.has_snapshot = "undone", now(), False
+        self.store.save(cs)
+        self._audit("agent.undone", changeset=cs.id)
+        self._stale_others(None)
+        self.store.prune_snapshots(UNDO_DEPTH)
+        msg = self.store.add_message("agent", f"Undid {cs.id} ({cs.instruction!r}). The data is back to how it was before it.",
+                                     "result", cs.id)
+        return {"changeset": cs.brief(), "message": msg.model_dump()}
+
+    def discard(self, cs_id: str) -> dict:
+        cs = self.store.get(cs_id)
+        if cs is None:
+            raise AgentError("no_such_changeset", f"There is no change {cs_id}.")
+        if cs.status not in ("proposed", "stale"):
+            raise AgentError("not_proposed", f"Change {cs_id} is {cs.status}; it cannot be discarded.")
+        cs.status = "discarded"
+        self.store.save(cs)
+        msg = self.store.add_message("agent", f"Discarded {cs.id}. Nothing was changed.", "result", cs.id)
+        return {"changeset": cs.brief(), "message": msg.model_dump()}
